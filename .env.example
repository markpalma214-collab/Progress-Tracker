# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True

# Comma-separated. Add your domain when you deploy.
ALLOWED_HOSTS=localhost,127.0.0.1

# Any IANA timezone name. "Today" / "this week" rankings use this zone.
TIME_ZONE=Asia/Manila

# Google OAuth (see README, "Google OAuth setup"). These placeholders show a Google button that
# will not work until replaced; leave both blank to hide the button.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Only for deployments behind a reverse proxy other than Vercel (Vercel is detected automatically).
# BEHIND_PROXY=True

# Seconds to keep a database connection open. 0 is right for serverless (Vercel).
# DB_CONN_MAX_AGE=0

# Leave blank to use SQLite (db.sqlite3). For PostgreSQL use e.g.
#   postgres://USER:PASSWORD@localhost:5432/progress_tracker
DATABASE_URL=
